# Required database configuration.
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.dtnfqocaymuarbbstdub
DB_PASSWORD=your_supabase_database_password
DB_NAME=postgres

# Required authentication and frontend-origin configuration.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_TOKEN_EXPIRY_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend-only provider credentials. Finnhub is required for full functionality.
# The other providers have partial fallbacks but should be configured in production.
FINNHUB_API_KEY=your_finnhub_api_key
TWELVEDATA_API_KEY=your_twelvedata_api_key
FMP_API_KEY=your_fmp_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
